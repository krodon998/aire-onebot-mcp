# ==========================================
# Aire OneBot Remote MCP Configuration
# ==========================================

# MCP service
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_AUTH_TOKEN=generate_a_secure_random_token_here

# Upstream OneBot v11 HTTP service (NapCat tested)
ONEBOT_API_BASE=http://127.0.0.1:3000
ONEBOT_API_TOKEN=
ONEBOT_TIMEOUT=30.0

# Backward compatibility:
# SNOWLUMA_API_BASE / SNOWLUMA_API_TOKEN / SNOWLUMA_TIMEOUT are still accepted.

# Optional image-view tuning
# VIEW_IMAGE_ENABLED=1
# VIEW_IMAGE_MAX_EDGE=1024
# VIEW_IMAGE_TARGET_BYTES=204800
# VIEW_IMAGE_MAX_SOURCE_BYTES=20971520
# VIEW_IMAGE_CACHE_BYTES=67108864
# VIEW_IMAGE_ALLOWED_HOSTS=qq.com,qq.com.cn
